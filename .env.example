# Copy to .env.local and fill in from Firebase console → Project settings → Your apps (Web).
# Leave empty to run in local demo mode (scores shared only between tabs of one browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: URL encoded in the TV display's QR code (defaults to the TV page's own origin).
VITE_PUBLIC_GAME_URL=
